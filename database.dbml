// ================================================
// SERVICIO TÉCNICO - ESTRUCTURA DE BASE DE DATOS
// Actualizado: 2026-03-21 (Auditoría Fase 1)
// ================================================

// ================================================
// 1. USUARIOS Y SEGURIDAD
// ================================================

Table users {
  id int [pk, increment]
  name varchar(255)
  email varchar(255) [unique]
  password varchar(255)
  created_at datetime
  updated_at datetime
  deleted_at datetime [null]
}

Table roles {
  id int [pk, increment]
  name varchar(50) [unique, note: 'super_admin, admin, tecnico, recepcionista, cajero']
  guard_name varchar(50)
  created_at datetime
  updated_at datetime
}

Table permissions {
  id int [pk, increment]
  name varchar(100)
  guard_name varchar(50)
  created_at datetime
  updated_at datetime
}

Table role_has_permissions {
  role_id int [pk]
  permission_id int [pk]
}

Table model_has_roles {
  role_id int [pk]
  model_type varchar(255)
  model_id int [pk]
}

Table personal_access_tokens {
  id int [pk, increment]
  tokenable_type varchar(255)
  tokenable_id int
  name varchar(255)
  token varchar(64) [unique]
  abilities text [null]
  last_used_at datetime [null]
  expires_at datetime [null]
  created_at datetime
  updated_at datetime
}

// ================================================
// 2. CATÁLOGOS (GENÉRICOS)
// ================================================

Table brands {
  id int [pk, increment]
  name varchar(100)
  is_active boolean [default: true]
  created_at datetime
  updated_at datetime
}

Table categories {
  id int [pk, increment]
  name varchar(100)
  parent_id int [null, note: 'para subcategorías']
  is_active boolean [default: true]
  created_at datetime
  updated_at datetime
}

Table payment_methods {
  id int [pk, increment]
  name varchar(50)
  type varchar(30) [note: 'cash, transfer, mobile, crypto']
  currency varchar(10) [note: 'Bs, USD, EUR']
  is_active boolean [default: true]
  created_at datetime
  updated_at datetime
}

// ================================================
// 3. TASA BCV (DÓLAR)
// ================================================

Table bcv_rates {
  id int [pk, increment]
  rate decimal(12,2) [note: 'precio del dólar en Bs']
  source varchar(50) [default: 'BCV', note: 'BCV, Paralelo, Personalizado']
  recorded_by int [null, note: 'quién lo registró manualmente']
  recorded_at datetime
  created_at datetime
  updated_at datetime
}

// ================================================
// 4. CLIENTES Y DISPOSITIVOS
// ================================================

// Tipos de dispositivos
Table device_types {
  id int [pk, increment]
  name varchar(50) [note: 'Celular, Laptop, Tablet, PC Escritorio, Consola, Otro']
  icon varchar(50) [null]
  is_active boolean [default: true]
  created_at datetime
  updated_at datetime
}

Table clients {
  id int [pk, increment]
  name varchar(150)
  document_id varchar(50) [null]
  phone varchar(50) [null]
  email varchar(150) [null]
  address text [null]
  notes text [null]
  is_active boolean [default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [null]
}

Table devices {
  id int [pk, increment]
  client_id int
  device_type_id int
  brand_id int
  model varchar(100) [note: 'string libre, ej: Galaxy S21, iPhone 15']
  serial varchar(100) [null, note: 'IMEI, número de serie']
  access_password varchar(150) [null]
  notes text [null]
  created_at datetime
  updated_at datetime
  deleted_at datetime [null]
}

// ================================================
// 5. SERVICIOS / TALLER
// ================================================

// Estados del taller (workflow)
Table workshop_statuses {
  id int [pk, increment]
  name varchar(50)
  slug varchar(50) [unique, note: 'recibido, diagnosticando, esperando_aprobacion, aprobado, desaprobado, en_reparacion, reparado, esperando_retiro']
  color varchar(20)
  description text [null]
  is_final boolean [default: false, note: 'si es estado final']
  notify_role varchar(50) [null, note: 'a quién notificar: tecnico, recepcionista']
  created_at datetime
  updated_at datetime
}

Table service_tickets {
  id int [pk, increment]
  ticket_number varchar(20) [unique, note: 'ej: TKT-2026-0001']
  device_id int
  client_id int [note: 'copia para referencia rápida']
  workshop_status_id int
  received_by int [note: 'usuario que recibe']
  technician_id int [null, note: 'técnico asignado']
  title varchar(150) [note: 'nombre corto']
  problem_reported text
  diagnosis text [null]
  estimated_price decimal(12,2) [null]
  final_price decimal(12,2) [null]
  work_done text [null]
  delivered_at datetime [null]
  created_at datetime
  updated_at datetime
  deleted_at datetime [null]
}

Table ticket_status_logs {
  id int [pk, increment]
  ticket_id int
  old_status_id int [null]
  new_status_id int
  user_id int
  notes text [null]
  created_at datetime
}

Table ticket_photos {
  id int [pk, increment]
  ticket_id int
  type varchar(20) [note: 'before, during, after']
  path varchar(255)
  description text [null]
  created_at datetime
  updated_at datetime
}

// ================================================
// 6. SERVICIOS (CATÁLOGO)
// ================================================

// Catálogo de servicios
Table services {
  id int [pk, increment]
  name varchar(150)
  description text [null]
  is_active boolean [default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [null]
}

// Precios por ubicación (workshop vs home)
Table service_prices {
  id int [pk, increment]
  service_id int
  location_type varchar(20) [note: 'workshop, home']
  price decimal(12,2)
  created_at datetime
  updated_at datetime
}

// Servicios aplicados a tickets
Table ticket_services {
  id int [pk, increment]
  ticket_id int
  service_id int [null, note: 'null si es servicio único temporal']
  custom_service_name varchar(150) [null, note: 'solo si service_id es null']
  location_type varchar(20) [note: 'workshop, home - para saber qué precio aplicar']
  price decimal(12,2) [note: 'precio final cobrado']
  discount_type varchar(10) [null, note: 'percentage, fixed']
  discount_value decimal(12,2) [default: 0]
  discount_amount decimal(12,2) [default: 0, note: 'monto descontado']
  discount_note text [null, note: 'nota interna para auditoría - solo visible para admins']
  notes text [null]
  created_at datetime
  updated_at datetime
}

// ================================================
// 7. INVENTARIO - PRODUCTOS
// ================================================

Table products {
  id int [pk, increment]
  category_id int
  name varchar(150)
  description text [null]
  sku varchar(100) [null, note: 'código interno']
  barcode varchar(100) [null, note: 'código de barras']
  price_bs decimal(12,2) [note: 'precio unitario en Bs - SIEMPRE igual']
  price_usd decimal(12,2) [note: 'precio unitario en USD - SIEMPRE igual']
  has_variants boolean [default: false, note: 'si tiene variantes (color, etc.)']
  has_inventory boolean [default: true, note: 'si maneja stock o no (servicios)']
  is_active boolean [default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [null]
}

// Variaciones (colores, tallas, etc.) - MISMO PRECIO que el producto base
Table product_variants {
  id int [pk, increment]
  product_id int
  name varchar(100) [note: 'Azul, Rojo, Talla M']
  sku varchar(100) [null]
  barcode varchar(100) [null]
  is_active boolean [default: true]
  created_at datetime
  updated_at datetime
  deleted_at datetime [null]
}

// Presentaciones (caja, docena, unidad) - solo define cantidad, NO el precio
Table product_presentations {
  id int [pk, increment]
  product_id int
  name varchar(50) [note: 'Caja, Paquete, Docena']
  units int [default: 1, note: 'cuántas unidades contiene (4, 12, 24)']
  is_default boolean [default: false]
  created_at datetime
  updated_at datetime
}

// Stock por presentación
Table product_stocks {
  id int [pk, increment]
  product_id int
  variant_id int [null, note: 'null si no tiene variantes']
  presentation_id int [null, note: 'null si no tiene presentaciones']
  quantity int [default: 0]
  min_stock_alert int [default: 0, note: 'alerta cuando baje de este número']
  location varchar(50) [null, note: 'taller, bodega, etc.']
  updated_at datetime
}

// ================================================
// 8. COMBOS / PAQUETES
// ================================================

Table combos {
  id int [pk, increment]
  name varchar(150)
  description text [null]
  price_bs decimal(12,2)
  price_usd decimal(12,2)
  is_active boolean [default: true]
  valid_from datetime [null]
  valid_until datetime [null]
  created_at datetime
  updated_at datetime
  deleted_at datetime [null]
}

Table combo_items {
  id int [pk, increment]
  combo_id int
  item_type varchar(20) [note: 'product, service']
  item_id int
  quantity int [default: 1]
  created_at datetime
}

// ================================================
// 9. VENTAS / POS / COTIZACIONES
// ================================================
// Sale Types:
// - sale: Venta concretada (Nota de Entrega), descuenta inventario
// - quote: Cotización, NO descuenta inventario
// ================================================

Table sales {
  id int [pk, increment]
  document_number varchar(20) [unique, note: 'ej: NTE-2026-0001 o COT-2026-0001']
  ticket_id int [null, note: 'si viene de un ticket']
  client_id int [null]
  user_id int
  type varchar(20) [note: 'pos, workshop']
  sale_type varchar(20) [default: 'sale', note: 'sale, quote']
  subtotal decimal(12,2)
  discount_type varchar(10) [null, note: 'none, percent, amount']
  discount_value decimal(12,2) [default: 0]
  discount_amount decimal(12,2) [default: 0]
  total_bs decimal(12,2)
  total_usd decimal(12,2)
  exchange_rate decimal(12,2) [note: 'tasa BCV usada']
  status varchar(20) [default: 'completed', note: 'completed, pending, cancelled']
  notes text [null]
  created_at datetime
  updated_at datetime
  deleted_at datetime [null]
}

Table sale_items {
  id int [pk, increment]
  sale_id int
  item_type varchar(20) [note: 'product, service, combo']
  product_id int [null]
  variant_id int [null]
  service_id int [null]
  combo_id int [null]
  presentation_id int [null, note: 'si se vendió por caja/docena']
  serial_number varchar(100) [null, note: 'serial del producto vendido']
  quantity int
  unit_price decimal(12,2)
  subtotal decimal(12,2)
  created_at datetime
  updated_at datetime
}

Table sale_payments {
  id int [pk, increment]
  sale_id int
  payment_method_id int
  amount decimal(12,2)
  amount_usd decimal(12,2) [null]
  reference varchar(100) [null, note: 'número de transferencia, etc.']
  paid_at datetime
  created_at datetime
  updated_at datetime
}

// ================================================
// 10. SOLICITUDES DE COMPRA
// ================================================

Table purchase_requests {
  id int [pk, increment]
  requested_by int
  status varchar(20) [default: 'pending', note: 'pending, approved, purchased, cancelled']
  notes text [null]
  created_at datetime
  updated_at datetime
}

Table purchase_request_items {
  id int [pk, increment]
  request_id int
  product_id int [null, note: 'null si es producto nuevo']
  product_name varchar(150) [note: 'nombre si no existe']
  quantity_needed int
  times_requested int [default: 1, note: 'cuántas veces se pidió']
  supplier_price decimal(12,2) [null]
  last_request_at datetime [null]
  created_at datetime
  updated_at datetime
}

// ================================================
// 11. NOTIFICACIONES
// ================================================

Table notifications {
  id int [pk, increment]
  type varchar(50) [note: 'new_ticket, diagnosis_ready, approved, etc.']
  title varchar(200)
  body text
  data json [null, note: 'datos adicionales']
  recipient_id int
  read_at datetime [null]
  created_at datetime
  updated_at datetime
}

Table notification_logs {
  id int [pk, increment]
  notification_id int
  user_id int
  action varchar(20) [note: 'sent, opened, clicked']
  created_at datetime
}

// ================================================
// 12. ACTIVITY LOGS (AUDITORÍA)
// ================================================

Table activity_logs {
  id int [pk, increment]
  user_id int [null]
  action varchar(50) [note: 'created, updated, deleted']
  entity_type varchar(100) [note: 'App\Models\Product']
  entity_id int [null]
  old_values json [null]
  new_values json [null]
  ip_address varchar(45) [null]
  user_agent text [null]
  created_at datetime
}

// ================================================
// 13. CONFIGURACIÓN
// ================================================

Table settings {
  id int [pk, increment]
  key varchar(100) [unique]
  value text
  type varchar(20) [default: 'string', note: 'string, boolean, number, json']
  group varchar(50) [default: 'general']
  description text [null]
  created_at datetime
  updated_at datetime
}

// ================================================
// 14. MULTIMEDIA
// ================================================

Table media {
  id int [pk, increment]
  model_type varchar(255)
  model_id int
  collection_name varchar(255) [null]
  file_name varchar(255)
  mime_type varchar(255)
  size int
  path varchar(255)
  created_at datetime
  updated_at datetime
}

// ================================================
// RELACIONES
// ================================================

// Usuarios y permisos
Ref: role_has_permissions.role_id > roles.id
Ref: role_has_permissions.permission_id > permissions.id
Ref: model_has_roles.role_id > roles.id

// BCV Rates
Ref: bcv_rates.recorded_by > users.id

// Catálogos
Ref: devices.client_id > clients.id
Ref: devices.device_type_id > device_types.id
Ref: devices.brand_id > brands.id
Ref: categories.parent_id > categories.id

// Taller
Ref: service_tickets.device_id > devices.id
Ref: service_tickets.client_id > clients.id
Ref: service_tickets.workshop_status_id > workshop_statuses.id
Ref: service_tickets.received_by > users.id
Ref: service_tickets.technician_id > users.id

Ref: ticket_status_logs.ticket_id > service_tickets.id
Ref: ticket_status_logs.old_status_id > workshop_statuses.id
Ref: ticket_status_logs.new_status_id > workshop_statuses.id
Ref: ticket_status_logs.user_id > users.id

Ref: ticket_photos.ticket_id > service_tickets.id

Ref: service_prices.service_id > services.id

Ref: ticket_services.ticket_id > service_tickets.id
Ref: ticket_services.service_id > services.id

// Inventario
Ref: products.category_id > categories.id
Ref: product_variants.product_id > products.id
Ref: product_presentations.product_id > products.id
Ref: product_stocks.product_id > products.id
Ref: product_stocks.variant_id > product_variants.id
Ref: product_stocks.presentation_id > product_presentations.id

// Combos
Ref: combo_items.combo_id > combos.id

// Ventas
Ref: sales.ticket_id > service_tickets.id
Ref: sales.client_id > clients.id
Ref: sales.user_id > users.id

Ref: sale_items.sale_id > sales.id
Ref: sale_items.product_id > products.id
Ref: sale_items.variant_id > product_variants.id
Ref: sale_items.service_id > services.id
Ref: sale_items.combo_id > combos.id
Ref: sale_items.presentation_id > product_presentations.id

Ref: sale_payments.sale_id > sales.id
Ref: sale_payments.payment_method_id > payment_methods.id

// Solicitudes
Ref: purchase_requests.requested_by > users.id
Ref: purchase_request_items.request_id > purchase_requests.id
Ref: purchase_request_items.product_id > products.id

// Notificaciones
Ref: notifications.recipient_id > users.id
Ref: notification_logs.notification_id > notifications.id
Ref: notification_logs.user_id > users.id

// Logs
Ref: activity_logs.user_id > users.id

// Media
Ref: media.model_id > users.id

// ================================================
// ORDEN DE MIGRACIONES SUGERIDO
// ================================================

